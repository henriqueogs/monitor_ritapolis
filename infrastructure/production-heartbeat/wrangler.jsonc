{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monitor-ritapolis-heartbeat",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",
  "vars": {
    "API_HEALTH_URL": "https://api.ritapolis.com/api/health"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
