DB_PATH=./data/ritapolis.db
LOG_DIR=./logs
API_PORT=3001
# Render injeta PORT automaticamente em producao; API_PORT fica como fallback local.
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001/api
ADMIN_AUTH_USER=
ADMIN_AUTH_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=1mb
RATE_LIMIT_PUBLICREAD=600
RATE_LIMIT_SEARCH=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_ADMINREAD=180
RATE_LIMIT_ADMINWRITE=60
RATE_LIMIT_EXPENSIVEJOB=20
COLETOR_DELAY_MS=1000
COLETOR_TIMEOUT_MS=15000
COLETOR_RETRY_MAX=3
COLETOR_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36
PREFEITURA_SYNC_CHECK_INTERVAL_MS=600000
IBGE_CODE=3156106
CNPJ_PREFEITURA=18557553000105
CNPJ_CAMARA=26148056000181

# PNCP — Portal Nacional de Contratações Públicas
# pncpBaseUrl: API de consulta (busca fuzzy por data + modalidade)
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
# pncpOrgaosUrl: API de órgãos (consulta direta por CNPJ — recomendada)
PNCP_ORGAOS_URL=https://pncp.gov.br/pncp-api/v1

# Scheduler de coletas automáticas
COLLECTION_SCHEDULER_ENABLED=true
COLLECTION_SCHEDULER_INTERVAL_HOURS=12
COLLECTION_SCHEDULER_CHECK_MS=3600000

# Scheduler de resumos IA (processa docs pendentes em ciclos)
AI_SCHEDULER_ENABLED=true
AI_SCHEDULER_DOCS_PER_CYCLE=15
AI_SCHEDULER_DELAY_BETWEEN_DOCS_MS=30000
AI_SCHEDULER_INTERVAL_MS=43200000

# IA - Resumo de PDFs
AI_SUMMARY_ENABLED=true
AI_PROVIDER=nvidia
AI_CONTRACT_VERSION=1.1
AI_MAX_CHARS_DIRECT=80000
AI_CHUNK_SIZE_CHARS=6000
AI_MIN_CHUNK_SIZE_CHARS=3000
AI_CHUNK_OVERLAP_CHARS=600
AI_MAX_CHUNKS_PER_DOCUMENT=40
AI_REQUEST_TIMEOUT_MS=120000
AI_RETRY_MAX=2
AI_SAVE_RAW_RESPONSE=false

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-sua-chave-aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Modelo de embeddings (agrupamento de produtos por similaridade — 3.3)
NVIDIA_EMBED_MODEL=baai/bge-m3

# Gemini fallback opcional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq fallback opcional
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
